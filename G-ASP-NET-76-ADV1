// Q1: What is a generic class? Why use generics?
// Answer:
// A generic class uses a type parameter such as T.
// Generics provide type safety and code reuse.


// Q2: Write a generic class Container<T> with Add and Get methods.
class Container<T>
{
    List<T> items = new List<T>();

    public void Add(T item)
    {
        items.Add(item);
    }

    public T Get(int index)
    {
        return items[index];
    }
}


// Q3: What are multiple type parameters? Write Pair<TKey, TValue>.
// Answer:
// Multiple type parameters allow a generic class to use more than one type.

class Pair<TKey, TValue>
{
    public TKey Key;
    public TValue Value;

    public Pair(TKey key, TValue value)
    {
        Key = key;
        Value = value;
    }
}


// Q4: What is a generic method? Write Swap<T> method.
// Answer:
// A generic method has its own type parameter.

static void Swap<T>(ref T a, ref T b)
{
    T temp = a;
    a = b;
    b = temp;
}


// Q5: Write a generic method FindMax<T> that finds maximum value.
// Answer:
// IComparable<T> allows the values to be compared.

static T FindMax<T>(T[] values)
    where T : IComparable<T>
{
    T max = values[0];

    for (int i = 1; i < values.Length; i++)
    {
        if (values[i].CompareTo(max) > 0)
            max = values[i];
    }

    return max;
}


