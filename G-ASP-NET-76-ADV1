// Q20: Create a generic Cache<TKey, TValue> with Add, Get, Remove,
// Contains, and expiration support.

class Cache<TKey, TValue>
{
    class Item
    {
        public TValue Value;
        public DateTime Expiration;
    }

    Dictionary<TKey, Item> items =
        new Dictionary<TKey, Item>();

    public void Add(TKey key, TValue value,
                    TimeSpan lifetime)
    {
        items[key] = new Item
        {
            Value = value,
            Expiration = DateTime.UtcNow.Add(lifetime)
        };
    }

    public bool Get(TKey key, out TValue value)
    {
        if (items.TryGetValue(key, out Item item))
        {
            if (DateTime.UtcNow < item.Expiration)
            {
                value = item.Value;
                return true;
            }

            items.Remove(key);
        }

        value = default(TValue);
        return false;
    }

    public bool Contains(TKey key)
    {
        TValue value;
        return Get(key, out value);
    }

    public bool Remove(TKey key)
    {
        return items.Remove(key);
    }
}
