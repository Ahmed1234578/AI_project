using System;
using System.Collections.Generic;
using System.Linq;

class Program
{
    static void Main()
    {
        // Exercise 1
        List<int> grades = new List<int>
        {
            85, 92, 78, 95, 88, 70, 100, 65
        };

        Console.WriteLine("Grades:");
        Console.WriteLine(string.Join(", ", grades));
        Console.WriteLine($"Count: {grades.Count}");
        Console.WriteLine($"First Grade: {grades.First()}");
        Console.WriteLine($"Last Grade: {grades.Last()}");

        grades.Sort();

        Console.WriteLine("\nSorted Grades:");
        Console.WriteLine(string.Join(", ", grades));

        int firstAbove90 = grades.First(g => g > 90);
        Console.WriteLine($"\nFirst grade above 90: {firstAbove90}");

        List<int> failingGrades = grades.Where(g => g < 75).ToList();
        Console.WriteLine("\nFailing Grades:");
        Console.WriteLine(string.Join(", ", failingGrades));

        grades.RemoveAll(g => g < 75);

        Console.WriteLine("\nGrades after removing failing grades:");
        Console.WriteLine(string.Join(", ", grades));

        bool has100 = grades.Any(g => g == 100);
        Console.WriteLine($"\nAny grade equal to 100? {has100}");

        List<string> gradeStrings = grades
            .Select(g => $"Grade: {g}")
            .ToList();

        Console.WriteLine("\nFormatted Grades:");
        foreach (string grade in gradeStrings)
        {
            Console.WriteLine(grade);
        }


        // Exercise 2
        SortedList<int, string> leaderboard = new SortedList<int, string>();

        leaderboard.Add(500, "Ahmed");
        leaderboard.Add(200, "Sara");
        leaderboard.Add(800, "Ali");
        leaderboard.Add(350, "Mona");

        Console.WriteLine("\nLeaderboard:");

        foreach (var entry in leaderboard)
        {
            Console.WriteLine($"Score: {entry.Key}, Player: {entry.Value}");
        }

        Console.WriteLine($"\nFirst Key: {leaderboard.Keys[0]}");
        Console.WriteLine($"First Value: {leaderboard.Values[0]}");

        bool exists = leaderboard.ContainsKey(500);
        Console.WriteLine($"\nDoes score 500 exist? {exists}");

        if (leaderboard.TryGetValue(999, out string player))
        {
            Console.WriteLine($"Player with score 999: {player}");
        }
        else
        {
            Console.WriteLine("No player has score 999.");
        }

        leaderboard.Remove(200);

        Console.WriteLine("\nUpdated Leaderboard:");

        foreach (var entry in leaderboard)
        {
            Console.WriteLine($"Score: {entry.Key}, Player: {entry.Value}");
        }


        // Exercise 3
        Dictionary<string, string> phoneBook =
            new Dictionary<string, string>();

        phoneBook.Add("Ahmed", "01011111111");
        phoneBook.Add("Sara", "01022222222");
        phoneBook.Add("Ali", "01033333333");
        phoneBook.Add("Mona", "01044444444");

        phoneBook["Omar"] = "01055555555";
        phoneBook["Ahmed"] = "01111111111";

        try
        {
            phoneBook.Add("Ahmed", "01234567890");
        }
        catch (ArgumentException ex)
        {
            Console.WriteLine("\nAdd() Error:");
            Console.WriteLine(ex.Message);
        }

        bool added = phoneBook.TryAdd("Ahmed", "01234567890");
        Console.WriteLine($"\nTryAdd succeeded? {added}");

        string searchName = "Khaled";

        if (phoneBook.ContainsKey(searchName))
        {
            Console.WriteLine($"{searchName} exists.");
        }
        else
        {
            Console.WriteLine($"{searchName} does not exist.");
        }

        string phoneNumber =
            phoneBook.GetValueOrDefault("Khaled", "Not Found");

        Console.WriteLine($"\nKhaled's phone number: {phoneNumber}");

        Console.WriteLine("\nKeys:");
        Console.WriteLine(string.Join(", ", phoneBook.Keys));

        Console.WriteLine("\nValues:");
        Console.WriteLine(string.Join(", ", phoneBook.Values));


        // Exercise 4
        HashSet<string> emails =
            new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        emails.Add("ahmed@test.com");
        emails.Add("AHMED@test.com");
        emails.Add("sara@test.com");
        emails.Add("Sara@Test.Com");

        Console.WriteLine($"\nEmail Count: {emails.Count}");

        Console.WriteLine("\nStored Emails:");

        foreach (string email in emails)
        {
            Console.WriteLine(email);
        }

        Console.WriteLine(
            "\nExplanation: The HashSet is case-insensitive, " +
            "so duplicate emails with different letter cases are " +
            "stored only once.");

        HashSet<int> setA = new HashSet<int>
        {
            1, 2, 3, 4, 5
        };

        HashSet<int> setB = new HashSet<int>
        {
            4, 5, 6, 7, 8
        };

        HashSet<int> union = new HashSet<int>(setA);
        union.UnionWith(setB);

        Console.WriteLine(
            $"\nUnionWith: {string.Join(", ", union)}");

        HashSet<int> intersection = new HashSet<int>(setA);
        intersection.IntersectWith(setB);

        Console.WriteLine(
            $"IntersectWith: {string.Join(", ", intersection)}");

        HashSet<int> except = new HashSet<int>(setA);
        except.ExceptWith(setB);

        Console.WriteLine(
            $"ExceptWith: {string.Join(", ", except)}");

        HashSet<int> subset = new HashSet<int>
        {
            1, 2
        };

        bool isSubset = subset.IsSubsetOf(setA);

        Console.WriteLine(
            $"\n{{1, 2}} is subset of Set A? {isSubset}");


        // Exercise 5
        Queue<string> printQueue =
            new Queue<string>();

        printQueue.Enqueue("Report.pdf");
        printQueue.Enqueue("Invoice.pdf");
        printQueue.Enqueue("Letter.docx");
        printQueue.Enqueue("Resume.pdf");
        printQueue.Enqueue("Photo.jpg");

        Console.WriteLine("\nPrint Queue:");

        foreach (string document in printQueue)
        {
            Console.WriteLine(document);
        }

        Console.WriteLine($"Count: {printQueue.Count}");

        Console.WriteLine(
            $"\nNext document: {printQueue.Peek()}");

        Console.WriteLine("\nProcessing Queue:");

        while (printQueue.Count > 0)
        {
            string document = printQueue.Dequeue();
            Console.WriteLine($"Printing: {document}");
        }

        bool dequeueSuccess =
            printQueue.TryDequeue(out string nextDocument);

        Console.WriteLine(
            $"\nTryDequeue succeeded? {dequeueSuccess}");

        if (dequeueSuccess)
        {
            Console.WriteLine($"Document: {nextDocument}");
        }
        else
        {
            Console.WriteLine(
                "Queue is empty, so TryDequeue returns false.");
        }


        // Exercise 6
        Stack<string> history =
            new Stack<string>();

        history.Push("google.com");
        history.Push("github.com");
        history.Push("stackoverflow.com");
        history.Push("youtube.com");
        history.Push("claude.ai");

        Console.WriteLine(
            $"\nCurrent Page: {history.Peek()}");

        Console.WriteLine("\nGoing Back:");

        for (int i = 0; i < 3; i++)
        {
            string leavingPage = history.Pop();
            Console.WriteLine($"Leaving: {leavingPage}");
        }

        Console.WriteLine(
            $"\nCurrent Page After Going Back: {history.Peek()}");

        history.Pop();
        history.Pop();

        bool popSuccess =
            history.TryPop(out string page);

        Console.WriteLine(
            $"\nTryPop succeeded? {popSuccess}");

        if (popSuccess)
        {
            Console.WriteLine($"Page: {page}");
        }
        else
        {
            Console.WriteLine(
                "Stack is empty, so TryPop returns false.");
        }
    }
}
